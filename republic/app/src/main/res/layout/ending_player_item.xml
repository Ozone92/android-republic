<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ending_item_card"
    style="@style/Widget.Republic.Card.Player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s">

    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ending_item_player_image"
            android:layout_width="0dp"
            android:contentDescription="@null"
            android:layout_height="@dimen/size_avatar"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_s"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="w,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/ending_item_text_barrier"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@drawable/hollande_1" />

        <TextView
            android:id="@+id/ending_item_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="PLAYER 2"
            app:layout_constraintBottom_toTopOf="@+id/ending_item_lost_text"
            app:layout_constraintEnd_toStartOf="@+id/ending_item_text_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ending_item_lost_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/ending_lost_alive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ending_item_text_barrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ending_item_player" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ending_item_text_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="ending_item_player,ending_item_lost_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>