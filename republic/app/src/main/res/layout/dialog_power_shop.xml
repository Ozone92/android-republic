<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/power_shop_title"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/power_shop_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />
        <TextView
            android:id="@+id/power_shop_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    android:id="@+id/power_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/power_placeholder_1"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/power_description_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/power_placeholder_description" />
                <Button
                    android:id="@+id/power_buy_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/power_shop_buy" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    android:id="@+id/power_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/power_placeholder_2"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/power_description_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/power_placeholder_description" />
                <Button
                    android:id="@+id/power_buy_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/power_shop_buy" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    android:id="@+id/power_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/power_placeholder_3"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/power_description_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/power_placeholder_description" />
                <Button
                    android:id="@+id/power_buy_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/power_shop_buy" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">
            <Button
                android:id="@+id/power_shop_reroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/power_shop_reroll" />
            <Button
                android:id="@+id/power_shop_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/power_shop_close" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
