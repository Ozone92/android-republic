<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/help_icon"
                android:layout_width="@dimen/size_touch_target"
                android:layout_height="@dimen/size_touch_target"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                tools:src="@drawable/stat_vote" />

            <TextView
                android:id="@+id/help_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                tools:text="@string/help_goal_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/help_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="@string/help_goal_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/help_page"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="1 / 5" />

            <Button
                android:id="@+id/help_previous"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/help_previous" />

            <Button
                android:id="@+id/help_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/help_next" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
