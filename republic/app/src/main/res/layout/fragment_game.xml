            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/game_middle_player_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="game_middle_player_popularity_text,game_middle_player_vote_text,game_middle_player_influence_text,game_middle_player_money_text"
