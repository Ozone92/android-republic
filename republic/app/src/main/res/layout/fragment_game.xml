<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.game.GameFragment">

    <com.epita.republic.views.common.HemicycleBackgroundView
        android:id="@+id/game_background"
        app:ambient="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/game_middle_player_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_player1_card"
        layout="@layout/view_player_card" />

    <include
        android:id="@+id/game_player1_card"
        android:layout_marginStart="@dimen/space_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toStartOf="@+id/game_player2_card"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_phase_text"
        layout="@layout/view_player_card" />

    <include
        android:id="@+id/game_player2_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toStartOf="@+id/game_player3_card"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/game_player1_card"
        app:layout_constraintTop_toBottomOf="@+id/game_phase_text"
        layout="@layout/view_player_card" />

    <include
        android:id="@+id/game_player3_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toStartOf="@+id/game_player4_card"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/game_player2_card"
        app:layout_constraintTop_toBottomOf="@+id/game_phase_text"
        layout="@layout/view_player_card" />

    <include
        android:id="@+id/game_player4_card"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/game_player3_card"
        app:layout_constraintTop_toBottomOf="@+id/game_phase_text"
        layout="@layout/view_player_card" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/game_dice_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_middle_player_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/game_dice_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_m"
                android:layout_marginTop="@dimen/space_s"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="@string/hint_keep_dice" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/game_dice_actions_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="game_dice_reroll,game_dice_confirm" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/game_dice_info"
                android:layout_width="@dimen/size_touch_target"
                android:layout_height="@dimen/size_touch_target"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_dice_info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dice_legend_open"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/game_dice1_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_dice1_btn"
                style="@style/Widget.Republic.Dice"
                android:layout_width="@dimen/size_dice"
                android:layout_height="@dimen/size_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_dice2_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/game_dice_info"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_dice2_btn"
                style="@style/Widget.Republic.Dice"
                android:layout_width="@dimen/size_dice"
                android:layout_height="@dimen/size_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_dice3_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/game_dice1_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_dice3_btn"
                style="@style/Widget.Republic.Dice"
                android:layout_width="@dimen/size_dice"
                android:layout_height="@dimen/size_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_dice4_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/game_dice2_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_dice4_btn"
                style="@style/Widget.Republic.Dice"
                android:layout_width="@dimen/size_dice"
                android:layout_height="@dimen/size_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_dice5_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/game_dice3_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_dice5_btn"
                style="@style/Widget.Republic.Dice"
                android:layout_width="@dimen/size_dice"
                android:layout_height="@dimen/size_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_dice6_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/game_dice4_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/game_dice6_btn"
                style="@style/Widget.Republic.Dice"
                android:layout_width="@dimen/size_dice"
                android:layout_height="@dimen/size_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_power_shop_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/game_dice5_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint" />

            <Button
                android:id="@+id/game_power_shop_btn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/game_dice_actions_barrier"
                app:layout_constraintStart_toEndOf="@+id/game_dice6_btn"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint"
                tools:text="@string/power_shop_open" />

            <Button
                android:id="@+id/game_dice_reroll"
                style="@style/Widget.Republic.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:text="@string/game_reroll_text"
                app:layout_constraintBottom_toTopOf="@+id/game_dice_confirm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/game_dice_hint"
                app:layout_constraintVertical_chainStyle="packed" />

            <Button
                android:id="@+id/game_dice_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:text="@string/game_validate_dice"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_dice_reroll" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/game_stay_leave_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_middle_player_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/game_stay_leave_question"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/game_stay_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_stay_btn_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/game_leave_btn"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />

            <Button
                android:id="@+id/game_leave_btn"
                style="@style/Widget.Republic.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_leave_btn_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/game_stay_btn"
                app:layout_constraintTop_toBottomOf="@+id/textView2" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/game_influence_choice_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_s"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_middle_player_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/game_influence_choice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/wickedness_card_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/game_influence_choice_recycler"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_s"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_influence_choice_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/game_phase_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/bg_phase_banner"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_xs"
        android:textAppearance="?attr/textAppearancePhase"
        tools:text="Player X : DICE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/game_elysee_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_elysee_label"
        android:elevation="@dimen/elevation_level3"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingVertical="@dimen/space_xxs"
        android:text="@string/game_elysee_label"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnElysee"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/game_middle_player_card"
        app:layout_constraintEnd_toEndOf="@id/game_middle_player_card"
        app:layout_constraintStart_toStartOf="@id/game_middle_player_card"
        app:layout_constraintTop_toTopOf="@id/game_middle_player_card" />

    <ImageButton
        android:id="@+id/game_help_btn"
        android:layout_width="@dimen/size_touch_target"
        android:layout_height="@dimen/size_touch_target"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_s"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/help_open"
        android:padding="@dimen/space_sm"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/game_turn_summary"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_turn_summary"
        android:elevation="@dimen/elevation_level3"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_l"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurfaceInverse"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/game_phase_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/game_phase_text"
        tools:text="Le Pen : +2 votes, 1 dégât à Mélenchon" />

</androidx.constraintlayout.widget.ConstraintLayout>