<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.ending.EndingFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ending_winner_card"
        style="@style/Widget.Republic.Card.Player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_s"
        app:layout_constraintBottom_toTopOf="@+id/ending_play_btn"
        app:layout_constraintEnd_toStartOf="@+id/ending_recycler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ending_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ending_winner_player_image"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_winner_avatar"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_s"
                android:contentDescription="@null"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="w,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/ending_winner_barrier"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@drawable/hollande_1" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/ending_winner_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="ending_winner_player_text,ending_winner_victory_text"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/ending_winner_player_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:visibility="gone"
                tools:text="PLAYER 1"
                app:layout_constraintBottom_toTopOf="@+id/ending_winner_victory_text"
                app:layout_constraintEnd_toStartOf="@+id/ending_winner_barrier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/ending_winner_victory_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_s"
                android:text="@string/ending_no_win"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ending_winner_barrier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ending_winner_player_text" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/ending_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/game_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ending_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintBottom_toTopOf="@+id/ending_play_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ending_winner_card"
        app:layout_constraintTop_toBottomOf="@+id/ending_title"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/ending_play_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ending_play_again_button"
        app:layout_constraintBottom_toTopOf="@+id/ending_menu_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/ending_menu_btn"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ending_menu_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>