<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.epita.republic.views.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_characterFragment"
            app:destination="@id/characterFragment" />
    </fragment>
    <fragment
        android:id="@+id/endingFragment"
        android:name="com.epita.republic.views.ending.EndingFragment"
        android:label="fragment_ending"
        tools:layout="@layout/fragment_ending" >
        <action
            android:id="@+id/action_endingFragment_to_characterFragment"
            app:destination="@id/characterFragment" />
        <action
            android:id="@+id/action_endingFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/gameFragment"
        android:name="com.epita.republic.views.game.GameFragment"
        android:label="fragment_game"
        tools:layout="@layout/fragment_game" >

        <argument
            android:name="characterId"
            app:argType="string" />

        <action
            android:id="@+id/action_gameFragment_to_endingFragment"
            app:destination="@id/endingFragment" />
    </fragment>
    <fragment
        android:id="@+id/characterFragment"
        android:name="com.epita.republic.views.character.CharacterFragment"
        android:label="fragment_character"
        tools:layout="@layout/fragment_character" >
        <action
            android:id="@+id/action_characterFragment_to_gameFragment"
            app:destination="@id/gameFragment" />
    </fragment>
</navigation>